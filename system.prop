# Lancelot Performance Booster - System Properties (KernelSU)
# Applied at post-fs-data stage via resetprop

# =====================
# VULKAN RENDERER
# =====================
debug.hwui.renderer=skiavk
ro.hwui.use_vulkan=true
debug.hwui.use_vulkan=true
debug.renderengine.backend=skiavk
debug.hwui.skip_damage_region=true
debug.hwui.profile=false
debug.hwui.show_dirty_regions=false
debug.hwui.render_dirty_regions=true
debug.hwui.skipshadercache=true

# =====================
# SURFACEFLINGER
# =====================
debug.sf.latch_unsignaled=1
debug.sf.enable_hwc_vds=0
ro.surface_flinger.max_frame_buffer_acquired_buffers=2

# =====================
# DALVIK / ART
# =====================
dalvik.vm.dex2oat-threads=4
dalvik.vm.image-dex2oat-threads=4
dalvik.vm.dex2oat-filter=speed
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heapmaxfree=8m
dalvik.vm.heapminfree=1m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.dex2oat-swap=false

# =====================
# TOUCH / INPUT
# =====================
ro.vendor.inputdevices.use_xiaomi_touch=1
persist.vendor.touch.game.mode=1
persist.vendor.touch.high.sample.rate=1

# =====================
# PERFORMANCE
# =====================
ro.config.perf=true
ro.sys.fw.bg_apps_limit=32
ro.config.max_bg_processes=6
persist.sys.dalvik.vm.lib.2=libart.so
ro.lmk.zram_enabled=true

# =====================
# NETWORK
# =====================
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_congestion_control=bbr
net.core.default_qdisc=fq
